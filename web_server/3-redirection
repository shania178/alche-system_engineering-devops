#!/usr/bin/env bash
# This script installs and configures Nginx to redirect /redirect_me to YouTube

apt-get update
apt-get install -y nginx

echo "Holberton School for the win!" > /var/www/html/index.html

sed -i '/listen 80 default_server;/a \\\tlocation /redirect_me { return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4; }' /etc/nginx/sites-available/default

service nginx restart
